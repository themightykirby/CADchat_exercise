# Copy to .env (git-ignored). Loaded with `node --env-file=.env`.
PORT=3000
NODE_ENV=development
# Exact frontend URL(s), comma-separated, no trailing slash, never *. Vite dev default shown.
# In development any localhost/127.0.0.1 port is also allowed (Vite hops ports).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...). Server only; bypasses RLS; never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# false = no login needed, anyone with the URL can use the API. Default true.
AUTH_REQUIRED=true
